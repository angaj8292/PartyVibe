# PartyVibe Environment Configuration Example

# Active Spring Profile (dev = H2 database, prod = PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Used in prod profile)
DATABASE_URL=jdbc:postgresql://localhost:5432/partyvibedb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgrespassword

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# LiveKit Voice Server
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend Configuration
VITE_API_URL=/api
