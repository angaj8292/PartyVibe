# PartyVibe Frontend - Vercel Production Environment Variables
# If deploying frontend to Vercel and backend to Render/Railway/VPS:

# Backend REST API URL (e.g., https://your-backend.railway.app/api)
VITE_API_URL=https://your-backend.railway.app/api

# Backend WebSocket STOMP URL (e.g., https://your-backend.railway.app/ws)
VITE_WS_URL=https://your-backend.railway.app/ws
